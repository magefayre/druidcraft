{
  "name": "@magefayre/druidcraft",
  "description": "Never struggle with choosing a Wild Shape again",
  "version": "1.18.6",
  "author": "Magefayre",
  "license": "ISC",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/magefayre/druidcraft.git"
  },
  "homepage": "https://github.com/magefayre/druidcraft#readme",
  "bugs": {
    "url": "https://github.com/magefayre/druidcraft/issues"
  },
  "packageManager": "yarn@4.18.0",
  "type": "module",
  "files": [
    "public",
    "src",
    ".env",
    "eslint.config.mjs",
    "jsconfig.json",
    "next-sitemap.js",
    "next.config.js",
    "postcss.config.js",
    "site.config.js",
    "svgr.config.js"
  ],
  "scripts": {
    "prepare": "husky",
    "clean": "rm -rf {.next,public/{robots.txt,sitemap*.xml}}",
    "prestart": "yarn clean || exit 0",
    "start": "next dev --webpack",
    "build": "next build --webpack",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "serve": "next start",
    "typegen": "concurrently 'yarn:typegen:*'",
    "typegen:5etools": "json2ts -i 'node_modules/5etools-utils/schema/site/**/(bestiary|util).json' -o src/types/5etools --unreachableDefinitions",
    "typegen:next": "next typegen",
    "presync-with-5etools": "yarn typegen:5etools",
    "sync-with-5etools": "tsx scripts/sync-with-5etools --output src/data",
    "postsync-with-5etools": "yarn format:js src/data",
    "pretest": "yarn typegen && tsc --noEmit",
    "test": "yarn lint && vitest run --coverage.enabled",
    "lint": "concurrently 'yarn:lint:*'",
    "lint:js": "eslint --cache .",
    "lint:css": "stylelint --cache --ignore-path .gitignore '**/*.?(s)css'",
    "format": "concurrently 'yarn:format:*'",
    "format:js": "yarn lint:js --fix",
    "format:css": "yarn lint:css --fix"
  },
  "dependencies": {
    "@newhighsco/chipset": "7.4.2",
    "@newhighsco/next-plugin-svgr": "3.0.176",
    "@newhighsco/press-start": "2.9.4",
    "@newhighsco/ts-config": "1.2.2",
    "@sindresorhus/slugify": "3.0.1",
    "@sindresorhus/transliterate": "2.3.1",
    "next": "16.3.4",
    "next-compose-plugins": "2.2.1",
    "next-sitemap": "4.2.3",
    "plur": "6.0.0",
    "postcss": "8.5.28",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sass": "1.104.0",
    "title-case": "4.3.2",
    "usehooks-ts": "3.1.1"
  },
  "devDependencies": {
    "5etools-utils": "0.16.43",
    "@commitlint/cli": "21.2.2",
    "@newhighsco/browserslist-config": "3.0.1",
    "@newhighsco/commitlint-config": "1.3.6",
    "@newhighsco/editor-config": "1.2.0",
    "@newhighsco/eslint-config": "7.1.47",
    "@newhighsco/lint-staged-config": "1.1.4",
    "@newhighsco/postcss-config": "4.0.76",
    "@newhighsco/prettier-config": "2.3.14",
    "@newhighsco/release-config": "1.5.10",
    "@newhighsco/stylelint-config": "4.0.55",
    "@newhighsco/svgr-config": "1.0.0",
    "@newhighsco/ts-config": "1.2.2",
    "@newhighsco/yarn-plugin-preset": "1.1.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.2.18",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "concurrently": "10.0.5",
    "css-select": "7.0.0",
    "domhandler": "6.0.1",
    "domutils": "4.0.2",
    "eslint": "10.9.1",
    "htmlparser2": "12.0.0",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "json-schema-to-typescript": "16.0.0",
    "lint-staged": "17.4.1",
    "prettier": "3.9.6",
    "semantic-release": "25.0.9",
    "stylelint": "17.14.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "yargs": "18.1.0"
  },
  "browserslist": [
    "extends @newhighsco/browserslist-config"
  ],
  "commitlint": {
    "extends": [
      "@newhighsco"
    ]
  },
  "prettier": "@newhighsco/prettier-config",
  "release": {
    "extends": "@newhighsco/release-config"
  },
  "stylelint": {
    "extends": [
      "@newhighsco/stylelint-config"
    ]
  }
}
